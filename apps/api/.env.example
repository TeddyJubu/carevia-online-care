# Copy to apps/api/.env. Every value here is for local development.

DATABASE_URL=postgresql://carevia:carevia@127.0.0.1:5432/carevia
# Port for `npm run db` (embedded Postgres). Keep it in step with DATABASE_URL.
PGPORT=5432
# The API listens on 127.0.0.1:PORT. Local default 4000; on the VPS 4100, behind nginx.
PORT=4000

# Better Auth signing secret. Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# The web origin patients use (links in emails point here; it proxies /api to this server).
PUBLIC_APP_URL=http://localhost:5180
# The admin app's origin (trusted for sign-in).
ADMIN_APP_URL=http://localhost:5174

# Demo mode: demo logins, demo payment, POST /api/demo/reset, and no two-factor requirement for staff.
# Off unless exactly "true".
DEMO_MODE=false
# "development" turns on GET /api/dev/outbox without demo mode. Use "production" in production.
NODE_ENV=development

# Where clinicians write the clinical record.
IMED_URL=https://imed.pt/imed/home
# Daily REST API base. Change only to point the smoke test at its local fake Daily.
DAILY_API_URL=https://api.daily.co/v1
# "true" only behind a reverse proxy that sets X-Forwarded-For (used for the rate-limit client IP).
TRUST_PROXY=false
# Fastify log level, or "silent".
LOG_LEVEL=info

# ---- Production on the VPS (nginx serves https://carevia.claudemod.tech and proxies /api to 127.0.0.1:4100,
# keeping the /api prefix) ----
# PORT=4100
# NODE_ENV=production
# DEMO_MODE=false            # or true for the client demo
# PUBLIC_APP_URL=https://carevia.claudemod.tech
# ADMIN_APP_URL=https://<admin origin>
# TRUST_PROXY=true           # nginx sets X-Forwarded-For
# BETTER_AUTH_SECRET=<new random value, not the development one>
