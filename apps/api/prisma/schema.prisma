generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  patient
  clinician
  admin
}

enum AppointmentStatus {
  confirmed
}

enum Channel {
  video
  audio
}

// Better Auth tables (user, session, account, verification). Field names follow Better Auth 1.7.
// dateOfBirth is a calendar date kept as "YYYY-MM-DD" text, so no time zone can shift it.
model User {
  id               String        @id
  name             String
  email            String        @unique
  emailVerified    Boolean       @default(false)
  image            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  firstName        String
  lastName         String
  phone            String
  dateOfBirth      String
  role             Role          @default(patient)
  twoFactorEnabled Boolean?      @default(false)
  twoFactors       TwoFactor[]
  sessions         Session[]
  accounts         Account[]
  appointments     Appointment[]
}

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// Better Auth two-factor plugin.
model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
}

// Emails that would have been sent. Written only in demo mode or development (GET /api/dev/outbox).
model OutboxMessage {
  id      String   @id @default(cuid())
  to      String
  subject String
  text    String
  links   String[]
  sentAt  DateTime @default(now())
}

model ServiceGroup {
  id        Int       @id
  name      String
  blurb     String
  icon      String
  sortOrder Int
  services  Service[]
  doctors   Doctor[]
}

model Service {
  id        Int          @id @default(autoincrement())
  groupId   Int
  group     ServiceGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int
  doctors   Doctor[]

  @@unique([groupId, name])
}

model Doctor {
  id                Int           @id
  name              String
  initials          String
  specialty         String
  languages         String
  fee               Int
  availabilityIndex Int
  experience        String
  education         String
  approach          String
  cedula            String
  groupId           Int
  group             ServiceGroup  @relation(fields: [groupId], references: [id])
  serviceId         Int
  service           Service       @relation(fields: [serviceId], references: [id])
  slots             Slot[]
  appointments      Appointment[]

  @@index([specialty])
  @@index([fee])
  @@index([availabilityIndex])
  @@index([groupId])
}

model Slot {
  id       Int      @id @default(autoincrement())
  doctorId Int
  doctor   Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  label    String
  day      String
  time     String
  startsAt DateTime

  @@unique([doctorId, label])
  @@index([doctorId, startsAt])
}

model Appointment {
  id            String            @id @default(cuid())
  patientId     String
  patient       User              @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId      Int
  doctor        Doctor            @relation(fields: [doctorId], references: [id])
  service       String
  slot          String
  channel       Channel
  status        AppointmentStatus @default(confirmed)
  fee           Int
  dailyRoomName String?
  dailyRoomUrl  String?
  createdAt     DateTime          @default(now())

  @@unique([doctorId, slot])
  @@index([patientId])
  @@index([doctorId])
}

model DailySettings {
  id        Int      @id @default(1)
  apiKey    String   @default("")
  updatedAt DateTime @updatedAt
}
